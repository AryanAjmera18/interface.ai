# Reserved configuration contract; runtime loading and offline adapters are not implemented yet.
# Absent: use the offline fake model; live Anthropic discovery is unavailable.
ANTHROPIC_API_KEY=
# Absent: disable LangSmith export; retain local file traces and evidence.
LANGSMITH_API_KEY=
# Absent: use the local project name "cua" when LangSmith export is explicitly enabled.
LANGSMITH_PROJECT=cua
# Absent or false: disable LangSmith tracing; use the local file trace exporter.
LANGSMITH_TRACING=false
# Absent: disable remote OTLP export; use the local file trace exporter.
OTEL_EXPORTER_OTLP_ENDPOINT=
# Absent: write local evidence and file traces under ./evidence/.
CUA_EVIDENCE_DIR=./evidence
