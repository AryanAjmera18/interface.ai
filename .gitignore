/evidence/*
!/evidence/demo/
# Preserve failure evidence, but never publish pre-mask AX blobs or live lock files.
!/evidence/discovery-00[1-9]/
!/evidence/discovery-00[1-9]/**
/evidence/discovery-00[1-9]/blobs/
/evidence/discovery-00[1-9]/*.lock
# Attempt 010 passed the identity, prompt, and key-material privacy scans.
!/evidence/discovery-010/
/evidence/discovery-010/browser-profile/
/evidence/discovery-010/*.lock
playwright-report/
test-results/
blob-report/
.playwright/
ms-playwright/

/evidence/discovery-00[1-9]/browser-profile/

# Publish deterministic replay evidence, excluding ephemeral browser state and live locks.
!/evidence/replay-*/
!/evidence/replay-*/**
/evidence/replay-*/browser-profile/
/evidence/replay-*/*.lock

# Publish same-session escalation evidence, excluding ephemeral browser state and locks.
!/evidence/escalation-*/
!/evidence/escalation-*/**
/evidence/escalation-*/browser-profile/
/evidence/escalation-*/*.lock
/evidence/escalation-*/checkpoints.sqlite*

# Attempt 001 stopped early and contains pre-fix raw synthetic identifiers; retain locally only.
/evidence/escalation-discovery-attempt-001/
/evidence/escalation-discovery-attempt-002/browser-profile/

# Publish cross-tenant evidence; browser profiles remain ephemeral.
!/evidence/cross-tenant-*/
!/evidence/cross-tenant-*/**
/evidence/cross-tenant-*/browser-profile/
/evidence/cross-tenant-*/*.lock

# Publish the catalog invocation and its linked replay; exclude ephemeral browser state.
!/evidence/catalog-invoke/
!/evidence/catalog-invoke/**
/evidence/catalog-invoke/replay/browser-profile/
/evidence/catalog-invoke/replay/*.lock

# Reviewer-created demo output.
/runs/
